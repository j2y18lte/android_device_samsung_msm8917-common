type j2y18_sec_radio_config, domain;
init_daemon_domain(j2y18_sec_radio_config)

# Give the Samsung config service a real domain instead of running it as init.
# Its exact private interface was not emitted in this log, so this is deliberately minimal.
hwbinder_use(j2y18_sec_radio_config)
binder_use(j2y18_sec_radio_config)

get_prop(j2y18_sec_radio_config, hwservicemanager_prop)

allow j2y18_sec_radio_config j2y18_sec_radio_config_hwservice:hwservice_manager add;
allow j2y18_sec_radio_config hidl_base_hwservice:hwservice_manager add;
