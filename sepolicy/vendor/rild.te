# Samsung operator-name SQLite database.
allow rild j2y18_sec_radio_data_file:dir create_dir_perms;
allow rild j2y18_sec_radio_data_file:file create_file_perms;
allow rild j2y18_sec_radio_data_file:file { lock map ioctl };

# Samsung preconfiguration marker.
allow rild system_data_file:dir { search write add_name };
type_transition rild system_data_file:file j2y18_radio_marker_file "preconfiged";
allow rild j2y18_radio_marker_file:file create_file_perms;

# Samsung private radio channel HIDL service.
allow rild j2y18_sec_radio_channel_hwservice:hwservice_manager add;

# Samsung RIL configures IPv6 parameters for mobile interfaces.
allow rild proc_net:file write;

# Samsung RIL reads interface traffic statistics.
allow rild proc_qtaguid_stat:file read;

# Samsung RIL checks telephony application data directories.
allow rild radio_data_file:dir search;

allow rild efs_file:dir search;

allow rild imei_efs_file:dir r_dir_perms;
allow rild imei_efs_file:file rw_file_perms;
allow rild imei_efs_file:file setattr;

allow rild app_efs_file:dir r_dir_perms;
allow rild app_efs_file:file r_file_perms;
